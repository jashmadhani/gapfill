# Copy to backend/.env (git-ignored) and fill in. Never paste keys into chat or commit them.

# Booking agent LLM (Google Gemini). Without it the agent runs its rules-based fallback, with the same guardrails.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Optional: Razorpay TEST keys. With both set, approvals open Razorpay's hosted checkout instead of the simulated one.
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=

# Optional: HMAC secret for QR tickets (otherwise generated into backend/.ticket_secret)
# TICKET_SECRET=

# Optional: hard ceiling for any single agent-prepared payment, in rupees
# AGENT_MAX_PROPOSAL=500000
