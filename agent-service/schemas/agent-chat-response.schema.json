{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reply": {
      "type": "string"
    },
    "navigate": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "enum": [
                "discover",
                "trip",
                "plan",
                "ask",
                "profile"
              ]
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "toolCalls": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "args": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "name",
          "args"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "reply",
    "toolCalls"
  ],
  "additionalProperties": false
}
